---
layout: base.njk
---
<article class="wrap page{% if wide %} page-wide{% endif %}">
  {%- if parent %}<p class="crumb"><a href="{{ parent.url }}">{{ parent.title }}</a></p>{% endif %}
  <h1>{{ title }}</h1>
  {%- if lede %}<p class="lede">{{ lede }}</p>{% endif %}
  <div class="prose">
{{ content | safe }}
  </div>
</article>
