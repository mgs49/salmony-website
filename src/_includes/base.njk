{%- set sec = section or "personal" -%}
{%- set menu = nav[navset or sec] -%}
<!doctype html>
<html lang="{{ lang or 'en-GB' }}"{% if sec == "personal" %} class="fun"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != menu.name %}{{ title }} - {% endif %}{{ menu.name }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
{% if redirect %}<meta http-equiv="refresh" content="0; url={{ redirect }}"><link rel="canonical" href="{{ redirect }}">{% endif %}
<link rel="icon" href="/assets/img/favicon-{{ sec }}.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/css/site.css">
{%- if sec == "personal" %}
<link rel="stylesheet" href="/assets/css/fun.css">
{%- endif %}
</head>
<body class="sec-{{ sec }}{% if bodyClass %} {{ bodyClass }}{% endif %}">
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="{{ menu.home }}">
      {%- if sec == "personal" %}<span class="seal" aria-hidden="true">MS</span>{% endif -%}
      <span class="brand-name">{{ menu.name }}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
      {%- for item in menu.links %}
        <li><a href="{{ item.url }}"{% if item.url == page.url or (item.url != menu.home and page.url | startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap footer-row">
    <p>© {{ "" | year }} Michael Salmony</p>
    {%- if sec == "personal" %}
    <p class="japan-fact"><span class="jp" lang="ja">日本</span> Curious Japan: <span id="japan-fact">{{ japanFacts[0] }}</span> - <a href="/personal/travels/michael-salmony-on-japan/#japcurio">more</a></p>
    <script>(function () { var f = {{ japanFacts | dump | safe }}; var e = document.getElementById("japan-fact"); if (e) e.textContent = f[Math.floor(Math.random() * f.length)]; })();</script>
    {%- else %}
    <ul>
      <li><a href="/">salmony.co.uk</a></li>
      <li><a href="/work/">Work</a></li>
      {%- if sec != "cookbook" %}<li><a href="/cookbook/">Cookbook</a></li>{% endif %}
      <li><a href="/contact/">Contact</a></li>
    </ul>
    {%- endif %}
  </div>
</footer>
</body>
</html>
